all:
	MAKE.EXE clean
	TCC.EXE -O -c -oVGA.OBJ VGA.C
	TCC.EXE -O -c -oRENDERER.OBJ RENDERER.C
	TCC.EXE -O -c -oKEYBRD.OBJ KEYBRD.C
	TCC.EXE -O -c -oVEC.OBJ VEC.C
	TCC.EXE -O -c -oMATX.OBJ MATX.C
	TCC.EXE -O -c -oMATH.OBJ MATH.C
	TCC.EXE -O -c -oMEM.OBJ MEM.C
	TCC.EXE -O -c -oTRINGL.OBJ TRINGL.C
	TCC.EXE -O MAIN.C MEM.OBJ VGA.OBJ RENDERER.OBJ KEYBRD.OBJ VEC.OBJ MATX.OBJ MATH.OBJ TRINGL.OBJ
clean:
	DEL MAIN.EXE
	DEL MAIN.OBJ
	DEL MEM.OBJ
	DEL VGA.OBJ
	DEL RENDERER.OBJ
	DEL KEYBRD.OBJ
	DEL VEC.OBJ
	DEL MATX.OBJ
	DEL MATH.OBJ
	DEL TRINGL.OBJ
	