all:
	MAKE.EXE clean
	TASM.EXE /ml VGA.ASM
	TCC.EXE -O -c -oRNDR.OBJ RNDR.C
	TCC.EXE -O -c -oKEYBRD.OBJ KEYBRD.C
	TCC.EXE -O -c -oVEC.OBJ VEC.C
	TCC.EXE -O -c -oMATX.OBJ MATX.C
	TCC.EXE -O -c -oMATH.OBJ MATH.C
	TCC.EXE -O -c -oCVEC.OBJ CVEC.C
	TCC.EXE -O 3DOS.C VGA.OBJ RNDR.OBJ KEYBRD.OBJ VEC.OBJ MATX.OBJ MATH.OBJ CVEC.OBJ
clean:
	DEL 3DOS.EXE
	DEL 3DOS.OBJ
	DEL VGA.OBJ
	DEL RNDR.OBJ
	DEL KEYBRD.OBJ
	DEL VEC.OBJ
	DEL MATX.OBJ
	DEL MATH.OBJ
	DEL CVEC.OBJ
	