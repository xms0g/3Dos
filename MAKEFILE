all:
	MAKE.EXE clean
	TASM.EXE /ml VGA.ASM
	TASM.EXE /ml KEYBRD.ASM
	TCC.EXE -O -c -oRNDR.OBJ RNDR.C
	TCC.EXE -O -c -oVEC3.OBJ VEC3.C
	TCC.EXE -O -c -oMATX.OBJ MATX.C
	TCC.EXE -O -c -oMATH.OBJ MATH.C
	TCC.EXE -O -c -oCVEC.OBJ CVEC.C
	TCC.EXE -O -c -oQSORT.OBJ QSORT.C
	TCC.EXE -O 3DOS.C VGA.OBJ RNDR.OBJ KEYBRD.OBJ VEC3.OBJ MATX.OBJ MATH.OBJ CVEC.OBJ QSORT.OBJ
clean:
	DEL 3DOS.EXE
	DEL 3DOS.OBJ
	DEL VGA.OBJ
	DEL RNDR.OBJ
	DEL KEYBRD.OBJ
	DEL VEC3.OBJ
	DEL MATX.OBJ
	DEL MATH.OBJ
	DEL CVEC.OBJ
	DEL QSORT.OBJ
	